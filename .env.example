# Copy this file to .env in the same folder. Never commit .env.

APP_NAME=PetMedia AI
APP_ENV=development
DEBUG=false

# The API has no user accounts. Keep it on localhost unless API_KEY is set
# and a proper reverse proxy is in front of it.
API_HOST=127.0.0.1
API_PORT=8000
# Optional. When set, requests must send the header "X-API-Key: <value>".
API_KEY=
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# SQLAlchemy URL for business data.
DATABASE_URL=postgresql+psycopg://petmedia:petmedia@127.0.0.1:5432/petmedia
# Plain libpq URL for LangGraph checkpoints (same server, separate schema).
LANGGRAPH_DATABASE_URL=postgresql://petmedia:petmedia@127.0.0.1:5432/petmedia
LANGGRAPH_SCHEMA=langgraph

# LLM: "mock" works offline, "openai_compatible" calls a real API.
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=120
LLM_TEMPERATURE=0.7
# "json_object" works with most providers; "json_schema" is stricter where supported.
LLM_STRUCTURED_MODE=json_object
LLM_MAX_STRUCTURED_RETRIES=3

# Images: "mock" works offline, "openai_compatible" calls a real API.
IMAGE_PROVIDER=mock
IMAGE_API_KEY=
IMAGE_MODEL=
IMAGE_BASE_URL=https://api.openai.com/v1
IMAGE_SIZE=1024x1536
IMAGE_TIMEOUT_SECONDS=180

# Relative paths are resolved against the project root (the folder with this file).
STORAGE_ROOT=./storage
# Optional path to a .ttf/.otf font. Empty uses the font bundled with Pillow.
FONT_PATH=

DEFAULT_LOCALE=en-US
DEFAULT_TARGET_MARKET=US
DEFAULT_IMAGE_COUNT=4
DEFAULT_TOPIC_COUNT=5
DEFAULT_TARGET_WORD_COUNT=700

WORKER_POLL_INTERVAL_SECONDS=2
WORKER_CONCURRENCY=2
JOB_LEASE_SECONDS=60
JOB_MAX_ATTEMPTS=3
MAX_GENERATION_RETRIES=3
MAX_COPY_AUTO_FIXES=2

MAX_UPLOAD_BYTES=10485760
MAX_IMAGE_PIXELS=40000000
MAX_OUTPUT_JPEG_BYTES=8000000

LOG_LEVEL=INFO
